OPENAI_API_KEY=
# one token per device: generate with `openssl rand -hex 24`
FERN_DEVICE_TOKENS=phone=CHANGE_ME,ipad=CHANGE_ME,laptop=CHANGE_ME
# virtual models (alias -> provider model); "litellm/..." for other providers or a local endpoint
FERN_MODELS='{"main": "gpt-5", "fast": "gpt-5-mini"}'
# untrusted | on-risk | never
FERN_APPROVAL=on-risk
# keep in sync with deploy/allowlist (app-level check + network-level proxy)
FERN_ALLOWED_HOSTS=api.openai.com,hacker-news.firebaseio.com,api.anthropic.com,api.github.com,ntfy.sh
# Home Assistant (optional): also add its host to deploy/allowlist
HA_URL=
HA_TOKEN=
# your timezone (alarms and briefing times are local)
FERN_TZ=Asia/Lisbon
# daily wake-up times to pre-generate the briefing for (alarms set through fern are added automatically)
FERN_BRIEFING_AT=
# briefing voice (OpenAI TTS); voices: alloy, ash, coral, echo, sage, shimmer, ...
FERN_TTS_VOICE=coral

# --- voice web app (fern_web) ---
# optional separate OpenAI project key limited to Realtime; falls back to OPENAI_API_KEY
FERN_WEB_OPENAI_KEY=
FERN_REALTIME_MODEL=gpt-realtime-2.1-mini
FERN_REALTIME_VOICE=marin
FERN_VOICE_DAILY_MINUTES=30
# --- Claude Code builder (docs/builder.md) ---
FERN_BUILDER_URL=
FERN_BUILDER_TOKEN=
# owner/name of the private repo + fine-grained read-only token (Pull requests: read, Checks: read)
FERN_GITHUB_REPO=
FERN_GITHUB_TOKEN=
# --- push notifications: install the ntfy app, subscribe to this topic (long and random = private) ---
FERN_NTFY_TOPIC=
